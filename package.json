{
  "name": "@permission-protocol/mcp-guard",
  "version": "0.2.0",
  "description": "MCP Guard blocks dangerous AI agent actions using a simple YAML config file.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/permission-protocol/mcp-guard.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/src/proxy.js",
  "bin": {
    "mcp-guard": "bin/mcp-guard"
  },
  "files": [
    "bin",
    "dist/src",
    "!dist/src/tests",
    "dist/example",
    "example",
    "templates",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "node --test dist/src/tests/*.test.js",
    "demo": "npm run build && bash example/test.sh",
    "deck": "npm run build && node scripts/deck.mjs",
    "slice1": "npm run build && node scripts/demo-slice1.mjs",
    "slice2": "npm run build && node scripts/demo-slice2.mjs",
    "slice25": "npm run build && node scripts/demo-slice25.mjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "guard",
    "proxy",
    "ai",
    "safety",
    "permission-protocol"
  ],
  "license": "MIT",
  "dependencies": {
    "fast-json-stable-stringify": "^2.1.0",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.15",
    "typescript": "^5.9.3"
  }
}
